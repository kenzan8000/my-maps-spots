# Copy to .env (same folder) and fill in. .env is git-ignored; never commit a real key.
# Restrict the key to "Places API (New)" in Google Cloud Console.
GOOGLE_MAPS_API_KEY=

# Optional: contact (email or URL) added to the User-Agent sent to OpenStreetMap and Wikidata.
# MY_MAPS_SPOTS_CONTACT=you@example.com
